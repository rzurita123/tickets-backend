<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SistemaTickets.Application\SistemaTickets.Application.csproj" />
    <ProjectReference Include="..\SistemaTickets.Infrastructure\SistemaTickets.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\tickets-frontend\index.html" Link="wwwroot\index.html" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\tickets-frontend\css\**\*" Link="wwwroot\css\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\tickets-frontend\js\**\*" Link="wwwroot\js\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\tickets-frontend\assets\**\*" Link="wwwroot\assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

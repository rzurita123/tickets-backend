{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SistemaTickets.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/SistemaTickets.Api/bin/Debug/net10.0/SistemaTickets.Api.dll",
      "cwd": "${workspaceFolder}/src/SistemaTickets.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5277"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\bNow listening on:\s+(https?://\S+)",
        "uriFormat": "%s/api/estado"
      },
      "stopAtEntry": false
    }
  ]
}
